# Preferred for PUBLIC repos / Vercel: keep the real API key here in the hosting dashboard.
CRICKETDATA_API_KEY=YOUR_FREE_API_KEY

# Official CricketData/CricAPI base URL
CRICKETDATA_BASE_URL=https://api.cricapi.com/v1

# Free-first mode avoids premium/fantasy scorecard calls by default.
CRICKETDATA_FREE_ONLY=1
CRICKET_MATCH_TTL_MS=180000
CRICKET_DETAIL_TTL_MS=900000
